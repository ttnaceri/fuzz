{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-backend",
	"main": "src/index.js",
	"compatibility_date": "2026-10-19",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	
	// D1 ma'lumotlar bazasi ulanishi (fuzz-db)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fuzz-db",
			"database_id": "6f0d45b2-c70c-46ba-b29f-beac16012e4b"
		}
	],
	
	// Ochiq sozlamalar. Maxfiy qiymatlar bu yerda EMAS — ular `wrangler secret put` orqali:
	//   BOT_TOKEN, JWT_SECRET, TELEGRAM_WEBHOOK_SECRET
	// Lokal ishlash uchun: .dev.vars fayli (gitignore'da)
	"vars": {
		"ADMIN_IDS": "6465879965"
	}
}